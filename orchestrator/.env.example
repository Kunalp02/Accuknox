# Database
DATABASE_URL=postgresql+asyncpg://orchestrator:orchestrator@localhost:5432/orchestrator

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM Gateway (Ollama Cloud / Bifrost — OpenAI-compatible)
LLM_GATEWAY_URL=http://localhost:11434/v1
LLM_GATEWAY_KEY=ollama
LLM_DEFAULT_MODEL=llama3.2
EMBED_MODEL=nomic-embed-text

# Qdrant
QDRANT_URL=http://localhost:6333

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=orchestrator

# Security
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRE_MINUTES=1440
ENCRYPTION_KEY=change-me-32-byte-base64-or-hex-key-for-secrets

ORG_RATE_LIMIT_PER_MINUTE=120

# App
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
