# syntax=docker/dockerfile:1

FROM python:3.12-slim AS base
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv
COPY . .
RUN uv sync --all-packages

FROM base AS api
EXPOSE 8000
CMD ["sh", "-c", "uv run alembic -c alembic.ini upgrade head && uv run --package orchestrator-api uvicorn orchestrator_api.main:app --host 0.0.0.0 --port 8000"]

FROM base AS worker
CMD ["uv", "run", "--package", "orchestrator-worker", "arq", "orchestrator_worker.tasks.WorkerSettings"]
