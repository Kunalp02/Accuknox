# App
APP_NAME=MCP AuthN AuthZ
API_HOST=0.0.0.0
API_PORT=8100
BASE_URL=http://localhost:8100
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (SQLite default for standalone dev)
DATABASE_URL=sqlite+aiosqlite:///./mcp_auth.db

# Security
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRE_MINUTES=1440
ENCRYPTION_KEY=change-me-32-byte-key-for-fernet-secrets

# MCP Server (inbound)
MCP_SERVER_RESOURCE_URI=http://localhost:8100/mcp
MCP_OAUTH_ISSUER=http://localhost:8100
